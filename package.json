{
  "name": "stealth-web-search",
  "version": "0.1.0",
  "description": "A stealth, JavaScript-rendering web browser and research sub-agents for AI agents over MCP, in one Docker container: full logging, a live dashboard, LM Studio integration and a JSON model config.",
  "type": "module",
  "license": "Apache-2.0",
  "homepage": "https://tanishmeh.github.io/stealth-web-search/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tanishmeh/stealth-web-search.git"
  },
  "bugs": {
    "url": "https://github.com/tanishmeh/stealth-web-search/issues"
  },
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "start": "node dist/main.js",
    "dev": "node --watch src/main.ts",
    "config:check": "node src/check-config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --test-reporter=spec test/unit/*.test.ts",
    "test:integration": "node --test --test-reporter=spec --test-concurrency=1 --test-timeout=600000 test/integration/*.test.ts",
    "test:ui": "node --test --test-reporter=spec --test-concurrency=1 --test-timeout=600000 test/ui/*.test.ts",
    "obscura:download": "node scripts/download-obscura.mjs",
    "stdio-bridge": "node dist/stdio-bridge.js",
    "lmstudio:setup": "node scripts/setup-lmstudio.mjs",
    "lmstudio:agent": "node scripts/lmstudio-agent.ts",
    "lmstudio:e2e": "node scripts/lmstudio-e2e.ts",
    "agents:e2e": "node scripts/agents-e2e.ts",
    "test:docker": "node --env-file=test/docker.env --test --test-reporter=spec --test-concurrency=1 --test-timeout=600000 test/integration/*.test.ts",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docs:tools": "node scripts/generate-tool-docs.ts",
    "site:build": "node scripts/build-site.ts",
    "site:serve": "node scripts/build-site.ts --serve"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "web-search",
    "stealth-browser",
    "headless-browser",
    "obscura",
    "research-agent",
    "sub-agents",
    "browser-automation",
    "lm-studio",
    "vllm",
    "openai-compatible",
    "docker"
  ],
  "dependencies": {
    "@jitl/quickjs-wasmfile-release-sync": "^0.32.0",
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/express": "^2.0.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "express": "^5.2.1",
    "hono": "^4.13.8",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "pino-roll": "^4.0.0",
    "quickjs-emscripten-core": "^0.32.0",
    "undici": "^7.30.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.5",
    "highlight.js": "^11.12.0",
    "marked": "^18.0.14",
    "typescript": "^7.0.2"
  }
}
