# Stealth Web Search configuration.
# Copy to .env (docker compose reads it automatically) and uncomment what you need.
# The value shown for each variable is its default. Options that have no default are left empty (`NAME=`),
# with an example in the comment above them where one helps.

# ----------------------------------------------------------------------------
# HTTP server: MCP endpoint (/mcp) and live dashboard (/)
# ----------------------------------------------------------------------------
# Host port published by docker compose (always bound to 127.0.0.1).
# HOST_PORT=8931

# Base URL shown in logs and on the dashboard. Under Compose, leave empty to default to
# http://127.0.0.1:${HOST_PORT}; set it if you reach the server through a different host or port.
# (HOST and PORT themselves are fixed by compose.yaml to 0.0.0.0:8931 inside the container -- use
#  HOST_PORT to change the published port, not PORT.)
# PUBLIC_URL=

# Require "Authorization: Bearer <token>" on /mcp and on the dashboard (open it once with ?token=<token>).
# Strongly recommended if the port is reachable by anyone but you.
# AUTH_TOKEN=

# Extra Host header values to accept (DNS-rebinding protection). localhost, 127.0.0.1, [::1] and
# host.docker.internal are always allowed. Add your hostname if you put a reverse proxy in front.
# ALLOWED_HOSTS=

# Serve the live dashboard at / (the MCP endpoint works either way).
# DASHBOARD_ENABLED=true

# Close MCP sessions that have been idle this long (ms). 0 disables.
# SESSION_IDLE_TIMEOUT_MS=1800000

# Maximum concurrent MCP sessions; further initialize requests get HTTP 503.
# MAX_SESSIONS=100

# Restrict which tools are exposed. Groups: core, content, forms, tabs, state, debug, capture, agents, scripts, snapshots (or "all").
# Individual tool names can be mixed in, e.g. TOOLSETS=core,content,browser_evaluate
# Small local models often work better with TOOLSETS=core,content,forms
# TOOLSETS=all

# ----------------------------------------------------------------------------
# Obscura browser
# ----------------------------------------------------------------------------
# Anti-detection mode: consistent browser fingerprint, TLS fingerprint impersonation, tracker blocking.
# OBSCURA_STEALTH=true

# Route all browser traffic through an HTTP or SOCKS5 proxy, e.g. socks5://user:pass@host:1080
# OBSCURA_PROXY=

# Override the User-Agent (the stealth profile provides a realistic one by default).
# OBSCURA_USER_AGENT=

# Allow the browser to open private/internal addresses (localhost, 10.x, 192.168.x, host.docker.internal).
# Off by default as SSRF protection. Turn on to browse services running on your machine.
# ALLOW_PRIVATE_NETWORK=false

# Persist cookies across container restarts. Empty by default (cookies are lost on restart). Set it to a
# mounted volume path to enable persistence, e.g. OBSCURA_STORAGE_DIR=/data/cookies with ./data:/data/cookies in compose.yaml
# (on Linux: mkdir -p data && sudo chown -R 1000:1000 data).
# WARNING: any page the agent visits can make cross-site requests carrying these cookies (Obscura v0.2.2
# does not enforce SameSite on navigations); do not persist sensitive logins. See docs/CONFIGURATION.md.
# OBSCURA_STORAGE_DIR=

# Navigation timeout (ms) and the watchdog that stops runaway page JavaScript (ms, 0 = off).
# OBSCURA_NAV_TIMEOUT_MS=30000
# OBSCURA_JS_WATCHDOG_MS=30000

# Restart Obscura automatically if it crashes (open tabs are lost; the agent is told).
# OBSCURA_RESTART_ON_CRASH=true

# Run sub-agent and script browsers on a second Obscura process, so a page that crashes the engine there
# never resets the main browser (always on with OBSCURA_STORAGE_DIR).
# OBSCURA_SEPARATE_ENGINE=true

# Obscura's own log filter (Rust tracing syntax). Its output is forwarded into our logs.
# OBSCURA_LOG_FILTER=warn,obscura=info,obscura_cdp=info,obscura_browser=warn

# Extra raw arguments for `obscura serve`.
# OBSCURA_EXTRA_ARGS=

# Connect to an Obscura instance you run yourself instead of starting one (advanced). Empty by default,
# which uses the bundled Obscura. Setting it DISABLES the bundled engine (no process is spawned), so
# leaving this uncommented will break the container. Example to attach to your own instance:
# ws://127.0.0.1:9222/devtools/browser
# OBSCURA_CDP_URL=

# Obscura release baked into the image (build argument; rebuild after changing). If you change it,
# also update the OBSCURA_SHA256_* build args in the Dockerfile.
# OBSCURA_VERSION=v0.2.2

# ----------------------------------------------------------------------------
# Browser behaviour
# ----------------------------------------------------------------------------
# VIEWPORT_WIDTH=1280
# VIEWPORT_HEIGHT=720

# URL schemes the agent may open. file: and javascript: can never be enabled.
# ALLOWED_URL_SCHEMES=http,https,about,data

# Upper bound for a single tool call, and for a single browser command (ms).
# TOOL_TIMEOUT_MS=120000
# CDP_COMMAND_TIMEOUT_MS=45000

# ----------------------------------------------------------------------------
# Live view (dashboard)
# ----------------------------------------------------------------------------
# LIVE_VIEW_ENABLED=true
# LIVE_VIEW_QUALITY=60
# LIVE_VIEW_MAX_WIDTH=1280
# LIVE_VIEW_MAX_HEIGHT=720

# ----------------------------------------------------------------------------
# Sub-agents: agent_run, agent_automate, agent_find (see docs/AGENTS.md)
# ----------------------------------------------------------------------------
# Recommended: describe the model in config/models.json instead of the AGENT_LLM_* variables below.
#   cp config/models.example.json config/models.json
# Format, rules and examples: docs/MODELS.md. The file is read at startup: after editing it, run
# docker compose restart. Check it with:
#   docker compose run --rm --no-deps stealth-web-search node dist/check-config.js --ping
# AGENT_LLM_* variables that are set override the matching fields of the file (url, apiKey, temperature,
# top_p, reasoning effort, streaming); AGENT_LLM_EXTRA_BODY is merged over its modelOptions.
#
# Models file to read. Empty = config/models.json if it exists (/app/config/models.json in Docker, where
# ./config is mounted read-only). Set a path inside the container to use another file, e.g.
# /app/config/openai.json, or "none" to ignore the file and use only the AGENT_LLM_* variables.
# AGENT_MODELS_FILE=

# Without a models file: OpenAI-compatible chat completions endpoint for the sub-agents (vLLM, LM Studio,
# llama.cpp, Ollama, OpenAI...). A base URL (http://host:8000/v1) or the full .../v1/chat/completions URL.
# Setting it enables the agent_* tools. From inside Docker, a model server on your machine is
# http://host.docker.internal:<port>/v1.
# e.g. http://192.168.1.50:8000/v1/chat/completions
# AGENT_LLM_URL=
# AGENT_LLM_API_KEY=
# Model id (default: the first model the endpoint lists). With a models file: which model of the file to
# use, by id, "<provider name>/<id>" or display name (default: the first model with tool calling).
# e.g. qwen3-32b
# AGENT_LLM_MODEL=

# Sampling and reasoning. REASONING_EFFORT is sent as reasoning_effort ("none" leaves it out);
# THINKING=true/false sends chat_template_kwargs.enable_thinking (Qwen-style templates; empty = model default).
# AGENT_LLM_TEMPERATURE=0.4
# AGENT_LLM_TOP_P=0.95
# "none" leaves temperature/top_p out; OpenAI reasoning models also need max_completion_tokens:
# AGENT_LLM_MAX_TOKENS_FIELD=max_tokens
# AGENT_LLM_REASONING_EFFORT=medium
# AGENT_LLM_THINKING=
# AGENT_LLM_STREAMING=true
# Extra JSON fields for every request, e.g. {"top_k": 20, "repetition_penalty": 1.05}
# AGENT_LLM_EXTRA_BODY=
# Longest silence from the endpoint before a request fails (ms).
# AGENT_LLM_TIMEOUT_MS=300000

# Context budget of a sub-agent (the transcript is compacted to fit) and output tokens per model turn
# (reasoning included). A models file caps them with the model's contextWindow and maxOutputTokens.
# AGENT_CONTEXT_TOKENS=65536
# AGENT_MAX_OUTPUT_TOKENS=8192

# Default step budget per run (the host can pass max_steps), wall-clock limit per run (ms), runs that
# work at the same time (the rest queue), and how long agent_* tools wait before answering
# "still running" (the run continues; collect it with agent_wait).
# AGENT_MAX_STEPS=40
# AGENT_MAX_RUNTIME_MS=900000
# AGENT_MAX_CONCURRENT=2
# AGENT_WAIT_SECONDS=170

# Tool results longer than this are shortened before they reach the sub-agent's model.
# AGENT_MAX_RESULT_CHARS=12000
# Search engine for web_search: duckduckgo (default, Bing as fallback) or bing.
# AGENT_SEARCH_ENGINE=duckduckgo
# Write a JSON transcript of every run to LOG_DIR/agent-runs/.
# AGENT_TRANSCRIPTS=true

# Sub-agent questions: a run can pause and ask the host (ask_host), which answers with agent_reply
# (e.g. before placing an order, or for a sign-in code). How long a paused run waits for the answer
# before it continues without one (ms, default 30 min), and how many questions one run may ask
# (0: sub-agents never ask). Secret answers (one-time codes) are masked in logs, transcripts and on the
# dashboard, but the sub-agent's model endpoint (AGENT_LLM_URL) receives them.
# AGENT_REPLY_TIMEOUT_MS=1800000
# AGENT_MAX_QUESTIONS=5

# Let a sub-agent save a sign-in it made during its job as a snapshot (save_sign_in), so later jobs start
# signed in. Only offered when the snapshots tools are enabled (TOOLSETS).
# AGENT_SNAPSHOT_SAVE=true

# ----------------------------------------------------------------------------
# Automation scripts (made by agent_automate, run with script_run)
# ----------------------------------------------------------------------------
# Where scripts are stored (/data/scripts in Docker: the "scripts" volume).
# SCRIPTS_DIR=
# Time limit and memory limit of one script run.
# SCRIPT_TIMEOUT_MS=300000
# SCRIPT_MEMORY_MB=64

# ----------------------------------------------------------------------------
# Snapshots (saved sign-ins: cookies and site storage, loaded with snapshot_load or agent_run)
# ----------------------------------------------------------------------------
# Where they are stored (/data/snapshots in Docker: the "snapshots" volume). They hold live session
# cookies: the folder is kept private (0700, files 0600). It must not be inside LOG_DIR or be SCRIPTS_DIR.
# SNAPSHOTS_DIR=
# Encrypt the saved cookies and storage at rest (AES-256-GCM; any string, keep it secret). Snapshots
# saved without a key are encrypted at the next start; changing the key makes older ones unreadable.
# SNAPSHOTS_KEY=

# ----------------------------------------------------------------------------
# Logging
# ----------------------------------------------------------------------------
# Console (docker logs) level and log file level: trace, debug, info, warn, error, silent.
# The file gets every MCP message, tool call, CDP command/event, page console message and network request at "debug".
# LOG_LEVEL=info
# LOG_FILE_LEVEL=debug

# "json" (default in Docker) or "pretty" (human readable).
# LOG_FORMAT=json

# Rotation: new file daily or when it reaches this size; keep this many old files.
# LOG_FILE_MAX_SIZE=20m
# LOG_FILE_MAX_FILES=14

# Long strings in logged payloads are truncated to this many characters (images are replaced by size + hash).
# LOG_MAX_STRING_LENGTH=2000

# Keep secrets out of logs and the dashboard: values typed into password/OTP-like fields, cookie values,
# exported/restored session state, and Cookie/Set-Cookie/Authorization headers. The agent still receives
# everything; only logs are masked. Set to false for full-fidelity debugging logs.
# LOG_REDACT_SECRETS=true

# Log every CDP event (network, console, lifecycle...). Turn off to reduce file size.
# LOG_CDP_EVENTS=true
